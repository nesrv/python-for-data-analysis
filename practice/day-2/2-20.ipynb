   "outputs": [],
   "source": [
    "def h1(fn):\n",
    "    def wrapper(word):\n",
    "        return '<h1>\\n' + fn(word) + '\\n</h1>'\n",
    "    return wrapper\n",
    "\n",
    "\n",
    "def p(fn):\n",
    "    def wrapper(word):\n",
    "        return '\\t<p>' + fn(word) + '</p>'\n",
    "    return wrapper\n",
    "\n",
    "@h1\n",
    "@p\n",
    "def hello(word):\n",
    "    return word"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "8d10b18b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
