   "source": [
    "def decorator(func):\n",
    "    def wrapper():        \n",
    "        print(\"before\")\n",
    "        func()\n",
    "        print(\"after\")\n",
    "    return wrapper   "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "87fa5f95",
   "metadata": {},
   "outputs": [],
   "source": [
    "@decorator\n",
    "def some_func():\n",
    "    print (\"Im func\")"
   ]
  },
