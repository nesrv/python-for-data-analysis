   "source": [
    "def fib(n):\n",
    "    '''\n",
    "    : 1,1,2,3,5,8,13,21 # Фибоначчи \n",
    "    : f(n) = f(n-2) + f(n-1)\n",
    "    '''\n",
    "    return 1 if n == 1 or n == 2 else fib(n-2) + fib(n-1)\n",
    "   "
   ]
